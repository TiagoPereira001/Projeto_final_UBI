# Bancada: modelo de configuração
#
# Copia este ficheiro para `.env` (na raiz do projeto) e preenche os valores.
# O mesmo `.env` serve para o docker compose e para a API (backend).
# NUNCA faças commit do `.env` verdadeiro: está no .gitignore.
#
# Passwords do SQL Server: mínimo 8 caracteres, com maiúsculas, minúsculas,
# números e símbolos (senão o SQL Server recusa-as).

# --- Base de dados --------------------------------------------------------
# password do utilizador administrador `sa`. Só é usada pelo Docker (para
# criar o servidor) e pelo `npm run db:setup` (para criar a base de dados).
DB_ADMIN_PASSWORD=

# password do login `bancada_app`, que é o único que a API usa no dia a dia.
# Este login só pode ler e escrever dados (sem permissões de administração).
DB_PASSWORD=

# (opcionais) valores por omissão para desenvolvimento local
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=Bancada
# DB_USER=bancada_app

# --- Sessões --------------------------------------------------------------
# segredo que assina as sessões (JWT). Tem de ter pelo menos 32 caracteres.
# Gera um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Servidor (opcionais) -------------------------------------------------
# PORT=3000
# origens de onde o browser pode fazer pedidos que alteram dados (proteção CSRF)
# APP_ORIGINS=http://localhost:5173,http://localhost:3000
# em produção, atrás de um proxy (nginx, Caddy...): número de proxies à frente
# TRUST_PROXY=1

# --- Dados de demonstração (npm run db:seed) ------------------------------
# se ficarem vazios, o seed gera uma password e PINs aleatórios e mostra-os
# SEED_GESTOR_EMAIL=gestor@duarte-raposo.test
# SEED_GESTOR_PASSWORD=
